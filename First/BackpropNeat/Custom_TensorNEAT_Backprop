      "cell_type": "code",
      "source": [
        "import json\n",
        "import numpy as np\n",
        "from datetime import datetime\n",
        "import random\n",
        "\n",
        "# Dataset label mapping\n",
        "DATASET_LABELS = {\n",
        "    'circle': 0,\n",
        "    'xor': 1,\n",
        "    'gaussian': 2,\n",
        "    'spiral': 3\n",
        "}\n",
        "\n",
        "def load_combined_dataset(filename='./2D Toy Dataset/combined_datasets.json'):\n",
        "    \"\"\"Load the combined dataset from JSON file.\"\"\"\n",
        "    print(f\"Loading {filename}...\")\n",
        "    try:\n",
        "        with open(filename, 'r') as f:\n",
        "            data = json.load(f)\n",
        "        print(f\"Successfully loaded {filename}\")\n",
        "        return data\n",
        "    except FileNotFoundError:\n",
        "        print(f\"Error: {filename} not found!\")\n",
        "        return None\n",
        "    except json.JSONDecodeError:\n",
        "        print(f\"Error: Invalid JSON in {filename}\")\n",
        "        return None\n",
        "\n",
        "def create_multi_dataset_with_labels(combined_data):\n",
        "    \"\"\"Create a multi-dataset where each point has both original and dataset labels.\"\"\"\n",
        "    print(\"\\nProcessing datasets...\")\n",
        "\n",
        "    # Initialize the new dataset structure\n",
        "    multi_dataset = {\n",
        "        'train': {\n",
        "            'inputs': [],\n",
        "            'original_labels': [],    # Original classification labels (0/1)\n",
        "            'dataset_labels': [],     # Dataset type labels (0-3)\n",
        "            'dataset_names': []       # Human-readable names\n",
        "        },\n",
        "        'test': {\n",
        "            'inputs': [],\n",
        "            'original_labels': [],\n",
        "            'dataset_labels': [],\n",
        "            'dataset_names': []\n",
        "        },\n",
        "        'metadata': {\n",
        "            'description': 'Multi-dataset with dataset type labels',\n",
        "            'input_dim': 2,\n",
        "            'num_datasets': 4,\n",
        "            'dataset_mapping': DATASET_LABELS,\n",
        "            'original_output_classes': 2,  # Binary classification\n",
        "            'dataset_output_classes': 4,   # 4 different datasets\n",
        "            'total_train_samples': 0,\n",
        "            'total_test_samples': 0,\n",
        "            'samples_per_dataset': {},\n",
        "            'generated_at': datetime.now().isoformat()\n",
        "        }\n",
        "    }\n",
        "\n",
        "    # Process each dataset\n",
        "    for dataset_name in DATASET_LABELS.keys():\n",
        "        dataset_label = DATASET_LABELS[dataset_name]\n",
        "\n",
        "        if dataset_name not in combined_data['datasets']:\n",
        "            print(f\"Warning: Dataset '{dataset_name}' not found in combined data\")\n",
        "            continue\n",
        "\n",
        "        dataset = combined_data['datasets'][dataset_name]\n",
        "        print(f\"Processing {dataset_name} dataset (label: {dataset_label})...\")\n",
        "\n",
        "        # Process training data\n",
        "        train_inputs = dataset['train']['inputs']\n",
        "        train_targets = dataset['train']['targets']\n",
        "\n",
        "        for input_vec, target in zip(train_inputs, train_targets):\n",
        "            multi_dataset['train']['inputs'].append(input_vec)\n",
        "            multi_dataset['train']['original_labels'].append(target)\n",
        "            multi_dataset['train']['dataset_labels'].append(dataset_label)\n",
        "            multi_dataset['train']['dataset_names'].append(dataset_name)\n",
        "\n",
        "        # Process test data\n",
        "        test_inputs = dataset['test']['inputs']\n",
        "        test_targets = dataset['test']['targets']\n",
        "\n",
        "        for input_vec, target in zip(test_inputs, test_targets):\n",
        "            multi_dataset['test']['inputs'].append(input_vec)\n",
        "            multi_dataset['test']['original_labels'].append(target)\n",
        "            multi_dataset['test']['dataset_labels'].append(dataset_label)\n",
        "            multi_dataset['test']['dataset_names'].append(dataset_name)\n",
        "\n",
        "        # Update metadata\n",
        "        multi_dataset['metadata']['samples_per_dataset'][dataset_name] = {\n",
        "            'train': len(train_inputs),\n",
        "            'test': len(test_inputs),\n",
        "            'total': len(train_inputs) + len(test_inputs)\n",
        "        }\n",
        "\n",
        "        print(f\"  Added {len(train_inputs)} training and {len(test_inputs)} test samples\")\n",
        "\n",
        "    # Update total counts\n",
        "    multi_dataset['metadata']['total_train_samples'] = len(multi_dataset['train']['inputs'])\n",
        "    multi_dataset['metadata']['total_test_samples'] = len(multi_dataset['test']['inputs'])\n",
        "\n",
        "    return multi_dataset\n",
        "\n",
        "def shuffle_dataset(dataset):\n",
        "    \"\"\"Shuffle the combined dataset while keeping labels aligned.\"\"\"\n",
        "    print(\"\\nShuffling dataset...\")\n",
        "\n",
        "    # Shuffle training data\n",
        "    train_data = list(zip(\n",
        "        dataset['train']['inputs'],\n",
        "        dataset['train']['original_labels'],\n",
        "        dataset['train']['dataset_labels'],\n",
        "        dataset['train']['dataset_names']\n",
        "    ))\n",
        "    random.shuffle(train_data)\n",
        "\n",
        "    # Unpack shuffled training data\n",
        "    dataset['train']['inputs'], dataset['train']['original_labels'], \\\n",
        "    dataset['train']['dataset_labels'], dataset['train']['dataset_names'] = zip(*train_data)\n",
        "\n",
        "    # Convert back to lists\n",
        "    dataset['train']['inputs'] = list(dataset['train']['inputs'])\n",
        "    dataset['train']['original_labels'] = list(dataset['train']['original_labels'])\n",
        "    dataset['train']['dataset_labels'] = list(dataset['train']['dataset_labels'])\n",
        "    dataset['train']['dataset_names'] = list(dataset['train']['dataset_names'])\n",
        "\n",
        "    # Shuffle test data\n",
        "    test_data = list(zip(\n",
        "        dataset['test']['inputs'],\n",
        "        dataset['test']['original_labels'],\n",
        "        dataset['test']['dataset_labels'],\n",
        "        dataset['test']['dataset_names']\n",
        "    ))\n",
        "    random.shuffle(test_data)\n",
        "\n",
        "    # Unpack shuffled test data\n",
        "    dataset['test']['inputs'], dataset['test']['original_labels'], \\\n",
        "    dataset['test']['dataset_labels'], dataset['test']['dataset_names'] = zip(*test_data)\n",
        "\n",
        "    # Convert back to lists\n",
        "    dataset['test']['inputs'] = list(dataset['test']['inputs'])\n",
        "    dataset['test']['original_labels'] = list(dataset['test']['original_labels'])\n",
        "    dataset['test']['dataset_labels'] = list(dataset['test']['dataset_labels'])\n",
        "    dataset['test']['dataset_names'] = list(dataset['test']['dataset_names'])\n",
        "\n",
        "    print(\"Dataset shuffled successfully\")\n",
        "\n",
        "def create_numpy_arrays(dataset):\n",
        "    \"\"\"Convert dataset to NumPy arrays for easier JAX/ML usage.\"\"\"\n",
        "    print(\"\\nConverting to NumPy arrays...\")\n",
        "\n",
        "    numpy_dataset = {\n",
        "        'train_X': np.array(dataset['train']['inputs']),\n",
        "        'train_y_original': np.array(dataset['train']['original_labels']),\n",
        "        'train_y_dataset': np.array(dataset['train']['dataset_labels']),\n",
        "        'test_X': np.array(dataset['test']['inputs']),\n",
        "        'test_y_original': np.array(dataset['test']['original_labels']),\n",
        "        'test_y_dataset': np.array(dataset['test']['dataset_labels']),\n",
        "        'dataset_mapping': DATASET_LABELS,\n",
        "        'metadata': dataset['metadata']\n",
        "    }\n",
        "\n",
        "    print(f\"Training data shape: {numpy_dataset['train_X'].shape}\")\n",
        "    print(f\"Test data shape: {numpy_dataset['test_X'].shape}\")\n",
        "\n",
        "    return numpy_dataset\n",
        "\n",
        "def save_dataset(dataset, filename):\n",
        "    \"\"\"Save dataset to JSON file.\"\"\"\n",
        "    print(f\"\\nSaving {filename}...\")\n",
        "    try:\n",
        "        with open(filename, 'w') as f:\n",
        "            json.dump(dataset, f, indent=2)\n",
        "        print(f\"Successfully saved {filename}\")\n",
        "    except Exception as e:\n",
        "        print(f\"Error saving {filename}: {e}\")\n",
        "\n",
        "def save_numpy_dataset(numpy_dataset, filename):\n",
        "    \"\"\"Save NumPy dataset (convert arrays to lists for JSON).\"\"\"\n",
        "    print(f\"\\nSaving {filename}...\")\n",
        "\n",
        "    # Convert NumPy arrays to lists for JSON serialization\n",
        "    json_dataset = {}\n",
        "    for key, value in numpy_dataset.items():\n",
        "        if isinstance(value, np.ndarray):\n",
        "            json_dataset[key] = value.tolist()\n",
        "        else:\n",
        "            json_dataset[key] = value\n",
        "\n",
        "    try:\n",
        "        with open(filename, 'w') as f:\n",
        "            json.dump(json_dataset, f, indent=2)\n",
        "        print(f\"Successfully saved {filename}\")\n",
        "    except Exception as e:\n",
        "        print(f\"Error saving {filename}: {e}\")\n",
        "\n",
        "def display_statistics(dataset):\n",
        "    \"\"\"Display dataset statistics.\"\"\"\n",
        "    print('\\n=== Dataset Statistics ===')\n",
        "    print(f\"Total training samples: {dataset['metadata']['total_train_samples']}\")\n",
        "    print(f\"Total test samples: {dataset['metadata']['total_test_samples']}\")\n",
        "    print(f\"Input dimensions: {dataset['metadata']['input_dim']}\")\n",
        "    print(f\"Number of datasets: {dataset['metadata']['num_datasets']}\")\n",
        "\n",
        "    print('\\nSamples per dataset:')\n",
        "    for name, counts in dataset['metadata']['samples_per_dataset'].items():\n",
        "        print(f\"  {name}: {counts['train']} train, {counts['test']} test, {counts['total']} total\")\n",
        "\n",
        "    print('\\nDataset label mapping:')\n",
        "    for name, label in DATASET_LABELS.items():\n",
        "        print(f\"  {name}: {label}\")\n",
        "\n",
        "    # Show distribution in training set\n",
        "    train_label_counts = {}\n",
        "    for label in dataset['train']['dataset_labels']:\n",
        "        train_label_counts[label] = train_label_counts.get(label, 0) + 1\n",
        "\n",
        "    print('\\nTraining set distribution:')\n",
        "    for label, count in train_label_counts.items():\n",
        "        dataset_name = [name for name, lbl in DATASET_LABELS.items() if lbl == label][0]\n",
        "        print(f\"  Label {label} ({dataset_name}): {count} samples\")\n",
        "\n",
        "def show_sample_data(dataset, num_samples=5):\n",
        "    \"\"\"Show sample data points.\"\"\"\n",
        "    print(f'\\n=== Sample Data Points (first {num_samples}) ===')\n",
        "\n",
        "    for i in range(min(num_samples, len(dataset['train']['inputs']))):\n",
        "        input_vec = dataset['train']['inputs'][i]\n",
        "        original_label = dataset['train']['original_labels'][i]\n",
        "        dataset_label = dataset['train']['dataset_labels'][i]\n",
        "        dataset_name = dataset['train']['dataset_names'][i]\n",
        "\n",
        "        print(f\"Sample {i + 1}:\")\n",
        "        print(f\"  Input: [{input_vec[0]:.3f}, {input_vec[1]:.3f}]\")\n",
        "        print(f\"  Original label: {original_label}\")\n",
        "        print(f\"  Dataset label: {dataset_label} ({dataset_name})\")\n",
        "        print()\n",
        "\n"
      ],
